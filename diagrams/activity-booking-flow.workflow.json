  "cards": [
    {
      "dot": "emerald",
      "title": "Two decisions carry the design",
      "items": [
        "Atomic hold: were the seats secured? This is where overselling is prevented",
        "Hold still alive? This is where the customer is protected from paying for nothing"
      ]
    },
    {
      "dot": "amber",
      "title": "The timer is not a step",
      "items": [
        "The 10 minutes can run out at any moment during the countdown, from outside the flow",
        "When it fires the seats go back on sale before any payment result arrives"
      ]
    }
